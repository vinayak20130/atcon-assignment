generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who can log in. Candidates are deliberately absent — they have no account
/// and reach their application through a signed link instead.
enum UserRole {
  RECRUITER
  INTERVIEWER

  @@map("user_roles")
}

/// The tenancy boundary.
///
/// Single-tenant in practice, but every table carries orgId: the column is free
/// now and painful to retrofit, and it marks where the boundary would go.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  jobs         JobRequisition[]
  candidates   Candidate[]
  applications Application[]
  templates PipelineTemplate[]

  interviews         Interview[]
  scorecardTemplates ScorecardTemplate[]
  scorecards         Scorecard[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  /// Deactivation rather than deletion: users are actors in the audit trail,
  /// and removing one would orphan the history of every decision they made.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]
  applicationEvents ApplicationEvent[] @relation("EventActor")
  createdJobs   JobRequisition[] @relation("JobCreatedBy")
  assignments   JobAssignment[]

  /// Unique per organization, not globally — the same person could work at two.
  interviewsCreated Interview[]         @relation("InterviewCreatedBy")
  panelSeats        InterviewPanelist[]
  scorecards        Scorecard[]         @relation("ScorecardInterviewer")

  @@unique([orgId, email])
  @@index([orgId, role])
  @@map("users")
}

/// Refresh tokens, stored hashed and rotated on every use.
///
/// `replacedById` makes reuse of an already-rotated token detectable, which is
/// the signal that a token was stolen. The response is to revoke the whole
/// chain rather than refuse the single request.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

/// The semantic role of a stage, independent of its display name.
///
/// A stage called "Founder Chat" and one called "Final Round" can both be
/// INTERVIEW. Metrics and guards key off this, never off the name, so renaming
/// a stage cannot break analytics.
enum StageType {
  APPLIED
  SCREEN
  ASSESSMENT
  INTERVIEW
  OFFER
  HIRED
  REJECTED

  @@map("stage_types")
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  FILLED

  @@map("job_statuses")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP

  @@map("employment_types")
}

model JobRequisition {
  id             String         @id @default(uuid()) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  title          String
  slug           String
  description    String
  department     String?
  location       String?
  employmentType EmploymentType @default(FULL_TIME) @map("employment_type")
  isRemote       Boolean        @default(false) @map("is_remote")
  openings       Int            @default(1)
  status         JobStatus      @default(DRAFT)

  createdById String @map("created_by_id") @db.Uuid

  /// Start of the clock for time-to-fill. Set once, on first publish — reopening
  /// a paused requisition must not restart it, because the role has been open
  /// the whole time from the business's point of view.
  openedAt  DateTime? @map("opened_at")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// The blueprint this was created from. Kept so you can answer "where did
  /// this pipeline come from", never used to look up stages — those live in
  /// `stages` and belong to this requisition alone.
  pipelineTemplateId String? @map("pipeline_template_id") @db.Uuid

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("JobCreatedBy", fields: [createdById], references: [id])
  pipelineTemplate PipelineTemplate? @relation(fields: [pipelineTemplateId], references: [id], onDelete: SetNull)

  stages       JobStage[]
  applications Application[]
  assignments JobAssignment[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("job_requisitions")
}

/// The requisition's own frozen copy of its pipeline.
///
/// Applications point here, never at a reusable template. That is what stops a
/// recruiter editing a template on Tuesday from reshaping the pipeline forty
/// candidates are already sitting in, or retroactively changing what last
/// quarter's conversion rates meant.
model JobStage {
  id                String    @id @default(uuid()) @db.Uuid
  jobId             String    @map("job_id") @db.Uuid
  name              String
  position          Int
  type              StageType
  /// Advancing OUT of this stage requires every required scorecard submitted.
  requiresScorecard Boolean   @default(false) @map("requires_scorecard")
  /// Days in this stage before an application is flagged stagnant.
  slaDays           Int?      @map("sla_days")

  job          JobRequisition     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]
  eventsFrom   ApplicationEvent[] @relation("EventFromStage")
  eventsTo     ApplicationEvent[] @relation("EventToStage")

  interviews Interview[]

  @@unique([jobId, position])
  @@index([jobId, type])
  @@map("job_stages")
}

/// The one scoping dimension on top of static roles.
///
/// A recruiter may only act on requisitions they are assigned to. Pure RBAC
/// would mean every recruiter reads every candidate's salary expectations,
/// which is wrong for an ATS; full ReBAC is more machinery than this earns.
/// Roles plus per-requisition assignment is the cheap 90%.
model JobAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isOwner   Boolean  @default(false) @map("is_owner")
  createdAt DateTime @default(now()) @map("created_at")

  job  JobRequisition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@map("job_assignments")
}

/// A reusable blueprint. Never referenced by an application.
///
/// Templates are org-level: "Engineering — Standard", "Design — Standard". A
/// recruiter picks one when creating a requisition, and its stages are COPIED
/// onto that requisition rather than referenced.
model PipelineTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org    Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineTemplateStage[]
  jobs   JobRequisition[]

  @@unique([orgId, name])
  @@map("pipeline_templates")
}

model PipelineTemplateStage {
  id                String    @id @default(uuid()) @db.Uuid
  templateId        String    @map("template_id") @db.Uuid
  name              String
  position          Int
  type              StageType
  requiresScorecard Boolean   @default(false) @map("requires_scorecard")
  slaDays           Int?      @map("sla_days")

  template PipelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("pipeline_template_stages")
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN

  @@map("application_statuses")
}

enum ApplicationSource {
  CAREERS_PAGE
  REFERRAL
  SOURCED
  IMPORT

  @@map("application_sources")
}

enum IdentityKeyType {
  EMAIL
  PHONE
  RESUME_HASH

  @@map("identity_key_types")
}

enum ParseStatus {
  PENDING
  SUCCEEDED
  PARTIAL
  FAILED

  @@map("parse_statuses")
}

/// A person being evaluated. Not a User: no password, never logs in.
///
/// They reach their application through a signed link instead, so there is no
/// account to create, no password to reset, and no candidate credential to leak.
model Candidate {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  fullName String  @map("full_name")
  /// Normalized name — the blocking key for fuzzy duplicate matching later.
  nameKey  String  @map("name_key")
  headline String?
  location String?

  primaryEmail String? @map("primary_email")
  primaryPhone String? @map("primary_phone")
  linkedinUrl  String? @map("linkedin_url")

  /// Denormalized for tag-style filtering. Skills are messy free text with no
  /// stable identity, so an array beats a join table that would fill with
  /// near-duplicate rows.
  skills String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org          Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identityKeys CandidateIdentityKey[]
  applications Application[]
  documents    Document[]

  @@index([orgId, nameKey])
  @@map("candidates")
}

/// Tier 1 of duplicate detection.
///
/// The unique index IS the rule: the database refuses a second candidate
/// carrying the same normalized email or E.164 phone, so correctness does not
/// depend on application code remembering to check first.
model CandidateIdentityKey {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @map("org_id") @db.Uuid
  candidateId String          @map("candidate_id") @db.Uuid
  type        IdentityKeyType
  /// The normalized form — never what the candidate typed.
  value       String
  createdAt   DateTime        @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([orgId, type, value])
  @@index([candidateId])
  @@map("candidate_identity_keys")
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  jobId          String            @map("job_id") @db.Uuid
  candidateId    String            @map("candidate_id") @db.Uuid
  /// Denormalized read model, rebuildable by replaying the event log.
  currentStageId String            @map("current_stage_id") @db.Uuid
  status         ApplicationStatus @default(ACTIVE)
  source         ApplicationSource @default(CAREERS_PAGE)

  /// Start of the clock for time-to-hire.
  appliedAt DateTime  @default(now()) @map("applied_at")
  decidedAt DateTime? @map("decided_at")
  /// Last activity. Lets the stagnation sweep avoid scanning the event log.
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  coverLetter String? @map("cover_letter")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job          JobRequisition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  currentStage JobStage       @relation(fields: [currentStageId], references: [id])
  documents    Document[]
  events       ApplicationEvent[]

  // "One ACTIVE application per candidate per requisition" is a PARTIAL unique
  // index added in a raw migration: Prisma cannot express WHERE on a unique
  // index, and a plain one would also block re-applying after a rejection,
  // which is a policy decision rather than a database invariant.
  interviews Interview[]
  scorecards Scorecard[]

  @@index([orgId, jobId, status])
  @@index([candidateId])
  @@map("applications")
}

model Document {
  id            String  @id @default(uuid()) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  candidateId   String  @map("candidate_id") @db.Uuid
  /// Resumes are tailored per role, so a document belongs to the application it
  /// arrived with, while staying indexed on the candidate.
  applicationId String? @map("application_id") @db.Uuid

  /// Object storage key. The bucket is private and the API hands out
  /// short-lived presigned URLs, so a resume is never reachable by guessing.
  storageKey String @map("storage_key")
  filename   String
  mimeType   String @map("mime_type")
  sizeBytes  Int    @map("size_bytes")
  /// Content hash. A dedupe signal and a re-upload guard — indexed but
  /// deliberately not unique, since the same file may legitimately be sent to
  /// two different requisitions.
  sha256     String

  parseStatus ParseStatus @default(PENDING) @map("parse_status")
  createdAt   DateTime    @default(now()) @map("created_at")

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([orgId, sha256])
  @@index([candidateId])
  @@map("documents")
}

enum ActorType {
  USER
  SYSTEM
  CANDIDATE

  @@map("actor_types")
}

enum ApplicationEventType {
  APPLICATION_RECEIVED
  STAGE_CHANGED
  REJECTED
  WITHDRAWN
  HIRED
  REOPENED
  NOTE_ADDED
  RESUME_PARSED
  RESUME_PARSE_FAILED
  MARKED_STAGNANT
  INTERVIEW_SCHEDULED
  INTERVIEW_CANCELLED
  INTERVIEW_CONCLUDED
  SCORECARD_SUBMITTED

  @@map("application_event_types")
}

/// The source of truth for an application's history.
///
/// Append-only, enforced by a database trigger rather than convention.
/// `Application.currentStageId` is a denormalized read model derived from this,
/// rebuildable by replaying the log — which a test asserts.
///
/// The audit trail, the analytics and the stagnation sweep are all readers of
/// this one table rather than three separate mechanisms.
model ApplicationEvent {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @map("org_id") @db.Uuid
  applicationId String               @map("application_id") @db.Uuid
  /// Monotonic per application. The unique index below makes a lost update
  /// impossible: two concurrent writers cannot both claim the same sequence.
  seq           Int
  type          ApplicationEventType
  fromStageId   String?              @map("from_stage_id") @db.Uuid
  toStageId     String?              @map("to_stage_id") @db.Uuid

  actorType ActorType @default(USER) @map("actor_type")
  /// Set only when actorType is USER. A check constraint enforces that, so a
  /// cron sweep can never be attributed to a person.
  actorId   String?   @map("actor_id") @db.Uuid
  /// Required for REJECT, REGRESS and REOPEN — the state machine refuses those
  /// without one, so the trail always explains a reversal.
  reason    String?
  metadata  Json?

  occurredAt DateTime @default(now()) @map("occurred_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage   JobStage?   @relation("EventFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     JobStage?   @relation("EventToStage", fields: [toStageId], references: [id], onDelete: SetNull)
  actor       User?       @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([applicationId, seq])
  @@index([applicationId, occurredAt])
  @@map("application_events")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED

  @@map("outbox_statuses")
}

/// Transactional outbox.
///
/// Side effects are written in the SAME transaction as the state change that
/// caused them, then relayed to the queue by a poller.
///
/// The two alternatives both lose work. Enqueuing inside the transaction leaves
/// a job pointing at a row a rollback removed. Enqueuing after the commit loses
/// the job entirely if the process dies in the gap — silently, with nothing
/// logged and nothing to retry.
///
/// That trades exactly-once for at-least-once, which is only safe because every
/// handler keys off `id` and is idempotent.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)

  attempts     Int       @default(0)
  /// Lets a failed relay back off without blocking the rest of the batch, and
  /// doubles as the lease: a claimed row is pushed into the future.
  availableAt  DateTime  @default(now()) @map("available_at")
  dispatchedAt DateTime? @map("dispatched_at")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("interview_statuses")
}

enum Recommendation {
  STRONG_NO
  NO
  YES
  STRONG_YES

  @@map("recommendations")
}

/// A scheduled conversation between a panel and a candidate, at one stage.
///
/// Scheduling itself is delegated to Cal.com: it owns availability, the invite
/// and the video link, all of which are a calendar product's job and none of
/// which this assignment would do better. What lives here is the part an ATS
/// cannot delegate — which stage the interview belongs to, who owes feedback,
/// and the audit trail. Every interview is a video call, so there is no mode.
model Interview {
  id            String @id @default(uuid()) @db.Uuid
  orgId         String @map("org_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  /// The stage this interview scores. Scorecard gating is per stage, so an
  /// interview that is not attached to one cannot gate anything.
  stageId       String @map("stage_id") @db.Uuid

  title          String
  scheduledStart DateTime        @map("scheduled_start")
  scheduledEnd   DateTime        @map("scheduled_end")
  timezone       String          @default("Asia/Kolkata")
  status         InterviewStatus @default(SCHEDULED)

  /// The Cal.com booking, and the meeting link it generated.
  ///
  /// A reference, not a source of truth. Nothing here polls Cal.com or receives
  /// its webhooks, so an interview rescheduled inside Cal.com will not sync
  /// back — a known limitation, and the first thing a real integration fixes.
  bookingUrl String? @map("booking_url")
  meetingUrl String? @map("meeting_url")

  notes            String?
  cancellationNote String? @map("cancellation_note")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       JobStage     @relation(fields: [stageId], references: [id])
  createdBy   User         @relation("InterviewCreatedBy", fields: [createdById], references: [id])

  panelists  InterviewPanelist[]
  scorecards Scorecard[]

  @@index([orgId, status, scheduledStart])
  @@index([applicationId])
  @@index([stageId])
  @@map("interviews")
}

/// Who is on the panel, and who owes a scorecard.
///
/// `isRequired` is the whole reason this is a table rather than an array of user
/// ids: a backup interviewer should be invited without their silence blocking
/// the candidate's progress.
model InterviewPanelist {
  id          String  @id @default(uuid()) @db.Uuid
  interviewId String  @map("interview_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  isRequired  Boolean @default(true) @map("is_required")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([userId])
  @@map("interview_panelists")
}

/// The question set a scorecard answers.
///
/// Templated rather than free text because "structured feedback" is the point:
/// comparing candidates needs everyone answering the same questions, and a
/// notes field cannot be compared across a panel.
model ScorecardTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  criteria   ScorecardCriterion[]
  scorecards Scorecard[]

  @@unique([orgId, name])
  @@map("scorecard_templates")
}

model ScorecardCriterion {
  id          String  @id @default(uuid()) @db.Uuid
  templateId  String  @map("template_id") @db.Uuid
  label       String
  description String?
  position    Int
  /// Relative weight when collapsing a scorecard into one number.
  weight      Float   @default(1)
  maxRating   Int     @default(5) @map("max_rating")

  template ScorecardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ratings  ScorecardRating[]

  @@unique([templateId, position])
  @@map("scorecard_criteria")
}

/// One interviewer's verdict on one interview.
model Scorecard {
  id            String @id @default(uuid()) @db.Uuid
  orgId         String @map("org_id") @db.Uuid
  interviewId   String @map("interview_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  interviewerId String @map("interviewer_id") @db.Uuid
  templateId    String @map("template_id") @db.Uuid

  /// Null while a draft — and the reason the row exists before it is finished.
  ///
  /// An interviewer may not read a colleague's scorecard until their own is
  /// submitted, so "started" and "committed" have to be distinguishable. A
  /// nullable timestamp does that with one column; an absent row could not.
  submittedAt    DateTime?       @map("submitted_at")
  recommendation Recommendation?
  summary        String?
  /// Weighted average of the ratings, normalized 0-1. Denormalized so a panel
  /// summary does not have to re-read every rating row.
  score          Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  interview   Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User              @relation("ScorecardInterviewer", fields: [interviewerId], references: [id], onDelete: Cascade)
  template    ScorecardTemplate @relation(fields: [templateId], references: [id])

  ratings ScorecardRating[]

  /// One scorecard per interviewer per interview. Their verdict is a single
  /// thing they revise, not a series of submissions.
  @@unique([interviewId, interviewerId])
  @@index([applicationId])
  @@map("scorecards")
}

model ScorecardRating {
  id          String  @id @default(uuid()) @db.Uuid
  scorecardId String  @map("scorecard_id") @db.Uuid
  criterionId String  @map("criterion_id") @db.Uuid
  rating      Int
  notes       String?

  scorecard Scorecard          @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  criterion ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, criterionId])
  @@map("scorecard_ratings")
}
