# Copy to .env: cp .env.example .env
# Variables are added as the features that read them are built.

NODE_ENV=development

DATABASE_URL="postgresql://atcon:atcon@localhost:5432/atcon_assignment?schema=public"

# Dev-only values. Rotate for anything real.
JWT_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"

REDIS_URL="redis://localhost:6379"
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
JOB_MAX_ATTEMPTS=5
STORAGE_ROOT="./storage"

# Mailpit catches everything the worker sends; read it at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="MoneyTicks <support@moneyticks.com>"
MAIL_ENABLED=true
WEB_PUBLIC_URL="http://localhost:3000"

# Brand / contact constants (referenced in code via src/common/constants.ts)
# SUPPORT_EMAIL=vinayak@moneyticks.com
# CAL_LINK=https://cal.com/vinayakits30/15min
