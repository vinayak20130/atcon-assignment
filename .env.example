# Copy to .env: cp .env.example .env
# Variables are added as the features that read them are built.

NODE_ENV=development

DATABASE_URL="postgresql://atcon:atcon@localhost:5432/atcon_assignment?schema=public"

# Dev-only values. Rotate for anything real.
JWT_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
